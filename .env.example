# Deepgram — https://console.deepgram.com
DEEPGRAM_API_KEY=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo del LLM. Los modelos "flash" priorizan latencia, que es lo que
# importa en un asistente de voz.
MODELO_LLM=gemini-2.5-flash

# Modelo de voz de Piper
RUTA_VOZ=modelos/es_ES-davefx-medium.onnx

# Palabra de activación.
# El umbral por defecto de openWakeWord es 0.5, pensado para voces inglesas.
# `hey_jarvis` dicho con acento castellano puntúa bastante más bajo: medido
# sobre audio real, los intentos válidos pican entre 0.39 y 0.50 y el ruido
# ambiente no llega a 0.12, así que 0.3 deja margen por los dos lados.
# Calíbralo para tu voz y tu micrófono con scripts/probar_wakeword.py.
MODELO_WAKEWORD=hey_jarvis
UMBRAL_WAKEWORD=0.3

# Modo conversación.
# Con true, la palabra clave abre una conversación y a partir de ahí se
# encadenan preguntas sin repetirla, con memoria de lo hablado. Se cierra
# con una frase de despedida, con un silencio largo, o ante un fallo.
# Con false, el asistente vuelve a una pregunta por cada palabra clave.
MODO_CONVERSACION=true

# Segundos de silencio que cierran la conversación. Es mucho más que los
# 3 s con los que se descarta un falso positivo del wake word: aquí el
# silencio es alguien pensando qué preguntar, no un aparato que se
# despertó solo. Súbelo si te corta mientras piensas.
SEGUNDOS_PARA_CERRAR_CONVERSACION=8

# Frases que cierran la conversación, separadas por comas. Vacío = las de
# fábrica (desactívate, inactívate, apágate, adiós, hasta luego, duérmete,
# me voy a dormir, eso es todo, nada más, olvídalo, cambio y corto...).
#
# Se comparan sin tildes, sin mayúsculas y sin puntuación, y una frase solo
# cuenta como despedida si: tiene cinco palabras o menos, no lleva
# interrogación, la despedida va al final, y no la precede un verbo de
# petición. Todas esas reglas están para el mismo lado: "¿cómo se dice
# adiós en francés?", "traduce hasta luego al alemán", "¿eso es todo?" y
# "ayúdame a dormir" son preguntas, no órdenes de apagado. Apagar el
# asistente cuando le preguntan algo es mucho peor que tardar ocho
# segundos de más en cerrarse.
#
# Las frases de más de cinco palabras se descartan al arrancar, porque
# nunca podrían reconocerse.
FRASES_DE_DESPEDIDA=

# Nivel de detalle del log: DEBUG, INFO, WARNING o ERROR. En INFO se ve
# cada turno de la conversación y por qué se cerró.
NIVEL_LOG=INFO

# Comunicación entre procesos
HOST_CARA=127.0.0.1
PUERTO_CARA=8765

# Dispositivos de audio. Vacío = el predeterminado del sistema.
# Usa scripts/listar_dispositivos.py para ver los nombres disponibles.
DISPOSITIVO_ENTRADA=
DISPOSITIVO_SALIDA=

# Pantalla
PANTALLA_COMPLETA=false
ANCHO=800
ALTO=480
