# Deepgram — https://console.deepgram.com
DEEPGRAM_API_KEY=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo del LLM. Los modelos "flash" priorizan latencia, que es lo que
# importa en un asistente de voz.
MODELO_LLM=gemini-2.5-flash

# Modelo de voz de Piper
RUTA_VOZ=modelos/es_ES-davefx-medium.onnx

# Palabra de activación.
# El umbral por defecto de openWakeWord es 0.5, pensado para voces inglesas.
# `hey_jarvis` dicho con acento castellano puntúa bastante más bajo: medido
# sobre audio real, los intentos válidos pican entre 0.39 y 0.50 y el ruido
# ambiente no llega a 0.12, así que 0.3 deja margen por los dos lados.
# Calíbralo para tu voz y tu micrófono con scripts/probar_wakeword.py.
MODELO_WAKEWORD=hey_jarvis
UMBRAL_WAKEWORD=0.3

# Comunicación entre procesos
HOST_CARA=127.0.0.1
PUERTO_CARA=8765

# Dispositivos de audio. Vacío = el predeterminado del sistema.
# Usa scripts/listar_dispositivos.py para ver los nombres disponibles.
DISPOSITIVO_ENTRADA=
DISPOSITIVO_SALIDA=

# Pantalla
PANTALLA_COMPLETA=false
ANCHO=800
ALTO=480
